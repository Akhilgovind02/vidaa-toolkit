# Copy to config.env and fill in. Then:  set -a; source config.env; set +a
VIDAA_TV_IP=192.168.1.50          # your TV's IP on the LAN
VIDAA_CERT=vidaa_cert.pem         # client cert PEM (see README: Obtaining the client certificate)
VIDAA_KEY=vidaa_key.pem           # client key PEM
# VIDAA_TV_MAC=aa:bb:cc:dd:ee:ff  # optional; any stable MAC-shaped id (default: random)
# VIDAA_PROFILE=modern            # modern | middle | remotenow | legacy
